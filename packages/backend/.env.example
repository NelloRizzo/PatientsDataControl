# ─── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173

# ─── MongoDB ─────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/healthbridge

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Brevo SMTP (free: 300 emails/day) ──────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-brevo-login@email.com
EMAIL_PASS=your-brevo-smtp-key
EMAIL_FROM=noreply@healthbridge.com

# ─── GROQ API (AI extraction from medical documents) ─
GROQ_API_KEY=gsk_your-groq-api-key

# ─── Fitbit Web API (legacy, optional) ───────────────
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# ─── Google Health API (for device sync) ─────────────
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
